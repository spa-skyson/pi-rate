#!/usr/bin/env bash
# pre-push: hard-fail when any commit about to be pushed is unsigned, lacks a
# Signed-off-by trailer, or carries an oversized blob.
#
# The size check is repeated here rather than left to pre-commit because a
# push is the last reversible moment: GitHub rejects a blob over 100 MiB and
# nothing can un-push one under that, so a commit that reached the branch some
# other way still has to be caught before the objects leave the machine.
#
# The post-commit hook only warns — it cannot stop an unsigned commit, and
# AGENTS.md records commits (0714568, a8b243b, bcb6d26) that reached the
# remote that way.
#
# Signature checking uses `git verify-commit`, NOT a gpgsig header test. The
# header only proves signing was attempted when the commit was created: rewrite
# the object afterwards (append a trailer, re-word the message with
# `git hash-object -t commit -w`, or drop a duplicate Signed-off-by) and the
# header survives while the signature becomes invalid. A header test therefore
# passes on commits GitHub marks `invalid`, which is how PR #345 published two
# of them through this very hook.
#
# `git verify-commit` needs gpg.ssh.allowedSignersFile configured (AGENTS.md,
# "Verify signatures with git verify-commit"). When it is missing, verification
# is impossible and this hook says so loudly rather than accepting the commit —
# an enforcement gate that silently passes is worse than none.
#
# Skipped worktrees (prunable entries) are ignored. Merge commits created by
# git itself are checked like any other commit.
#
# One sanctioned exception: mirror convergence. A PR merged through the
# GitHub web UI lands on origin/main only, and the fix is an empty converge
# merge on gitlab pushed back to origin — a push that carries the unsigned
# GitLab-created merge commits with it. Those commits are legal here
# (AGENTS.md: "GitLab-created merge commits on main are unsigned ... Do not
# 'fix' them") but they cannot be re-signed locally, so without an exception
# the mirror could never converge again. PI_PREPUSH_ALLOW_SERVER_MERGES=1 is
# that exception, scoped as narrowly as PI_ALLOW_LARGE_FILES in
# check-large-files: with it set, unsigned commits that ARE merges (two or
# more parents) warn instead of failing and are exempt from the
# Signed-off-by check as well — a merge commit built by the GitLab web UI
# carries neither a user signature nor a user Signed-off-by, and neither
# can be added without rewriting the commit. A merge may also carry a VALID
# signature with no Signed-off-by — a local converge merge created with -S
# and no -s, already published on gitlab: rewriting it would invalidate
# published history, and the signature proves authorship more strictly than
# the trailer would, so under the same variable it warns "(signed,
# Signed-off-by waived)" instead of failing. Unsigned non-merge commits
# still fail both checks unconditionally, the size check is unchanged for
# every commit, and without the variable the hook behaves exactly as
# before.
set -euo pipefail

remote="$1"
zero=0000000000000000000000000000000000000000

unsigned=()
missing_sob=()
size_scan=()
server_merges=()
signed_merges_nosob=()

# Set only for the mirror-converge push; see the header comment.
allow_server_merges="${PI_PREPUSH_ALLOW_SERVER_MERGES:-}"

# Without this file `git verify-commit` cannot verify anything, so every commit
# would look unsigned and the hook would be useless whichever way it failed.
if [ -z "$(git config --get gpg.ssh.allowedSignersFile || true)" ]; then
  echo "pre-push: gpg.ssh.allowedSignersFile is not configured, so signatures" >&2
  echo "          cannot be verified. Set it up once (see AGENTS.md):" >&2
  echo "            echo \"$(git config user.email) \$(git config user.signingkey)\" \\" >&2
  echo "              > ~/.config/git/allowed_signers" >&2
  echo "            git config --global gpg.ssh.allowedSignersFile ~/.config/git/allowed_signers" >&2
  exit 1
fi

verify_signature() {
  git verify-commit "$1" >/dev/null 2>&1
}

# A merge commit has two or more parents; `git rev-list --parents -n 1`
# prints the commit followed by every parent.
is_merge() {
  [ "$(git rev-list --parents -n 1 "$1" | wc -w)" -gt 2 ]
}

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion or remote already has the ref with no new commits.
  [ "$local_sha" = "$zero" ] && continue

  # Determine the range of new commits being pushed.
  if [ "$remote_sha" = "$zero" ]; then
    # New ref: everything not reachable from any existing remote branch,
    # limited to what this push would add. Fall back to the full history
    # behind local_sha minus existing remotes to avoid re-checking history.
    range="$(git rev-list "$local_sha" --not --remotes="$remote")"
    size_scan+=("$local_sha" --not --remotes="$remote")
  else
    # Exclude commits already reachable from a remote branch. After a
    # rebase onto an updated main, remote_sha..local_sha also spans the
    # upstream commits the rebase pulled in — commits that are already
    # published and are not this push's to vouch for.
    range="$(git rev-list "$remote_sha..$local_sha" --not --remotes="$remote")"
    size_scan+=("$remote_sha..$local_sha" --not --remotes="$remote")
  fi

  for sha in $range; do
    # Classify once: under the escape hatch an unsigned merge commit is
    # warned about and skips BOTH the signature and the Signed-off-by gate
    # — a server-built merge cannot carry a user Signed-off-by any more
    # than it can carry a user signature. A merge with a VALID signature
    # but no Signed-off-by waives the same way: the signature proves
    # authorship more strictly than the trailer would, and the commit may
    # already be published on gitlab and cannot be rewritten.
    server_merge=""
    if ! verify_signature "$sha"; then
      if [ -n "$allow_server_merges" ] && is_merge "$sha"; then
        server_merges+=("$sha")
        server_merge=1
      else
        unsigned+=("$sha")
      fi
    elif [ -n "$allow_server_merges" ] && is_merge "$sha" &&
         [ -z "$(git log --format='%(trailers:key=Signed-off-by,valueonly)' -1 "$sha" | tr -d '[:space:]')" ]; then
      signed_merges_nosob+=("$sha")
      server_merge=1
    fi
    if [ -n "$server_merge" ]; then
      continue
    fi
    trailers="$(git log --format='%(trailers:key=Signed-off-by,valueonly)' -1 "$sha")"
    committer_email="$(git log --format='%ce' -1 "$sha")"
    if [ -z "$(echo "$trailers" | tr -d '[:space:]')" ]; then
      missing_sob+=("$sha")
    elif ! echo "$trailers" | grep -qi "$committer_email"; then
      missing_sob+=("$sha")
    fi
  done
done

fail=0
if [ "${#size_scan[@]}" -gt 0 ]; then
  "$(dirname "$0")/check-large-files" commits "${size_scan[@]}" || fail=1
fi
if [ "${#server_merges[@]}" -gt 0 ]; then
  echo "pre-push: WARNING: server-side merge commits allowed by PI_PREPUSH_ALLOW_SERVER_MERGES (unsigned, Signed-off-by waived):" >&2
  printf '  %s\n' "${server_merges[@]}" >&2
fi
if [ "${#signed_merges_nosob[@]}" -gt 0 ]; then
  echo "pre-push: WARNING: merge commits allowed by PI_PREPUSH_ALLOW_SERVER_MERGES (signed, Signed-off-by waived):" >&2
  printf '  %s\n' "${signed_merges_nosob[@]}" >&2
fi
if [ "${#unsigned[@]}" -gt 0 ]; then
  echo "pre-push: commits whose signature is missing or INVALID cannot be pushed:" >&2
  printf '  %s\n' "${unsigned[@]}" >&2
  echo "  A gpgsig header is not enough — these fail git verify-commit." >&2
  echo "  Re-sign them:  git rebase --exec 'git commit --amend --no-edit -S' origin/main" >&2
  echo "  Do NOT hand-edit the commit object; that is what invalidates it." >&2
  fail=1
fi
if [ "${#missing_sob[@]}" -gt 0 ]; then
  echo "pre-push: commits missing a matching Signed-off-by trailer:" >&2
  printf '  %s\n' "${missing_sob[@]}" >&2
  echo "  Fix with:      git rebase --exec 'git commit --amend --no-edit -S' origin/main" >&2
  echo "  (-s adds a second trailer when the message already has one)" >&2
  fail=1
fi
exit $fail
